# Database
DATABASE_URL="postgresql://mc-scholar:mc-scholar-password@localhost:5432/mc-scholar-db?schema=public"

# Better Auth
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# App
PORT=3000
NODE_ENV=development

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Attendance — fraction of sessions a student may miss before being flagged atRisk (0.0–1.0)
AT_RISK_THRESHOLD=0.20